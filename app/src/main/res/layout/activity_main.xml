<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:layout_marginStart="10dp"
        android:text="vertical-acceleration"
        android:textAlignment="center"
        android:paddingTop="75dp"
        android:background="@drawable/circle_outer_foreground"
        android:id="@+id/accelerate_vert_outer"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle_foreground"
            android:layout_below="@id/accelerate_vert_outer"
            android:layout_marginTop="-140dp"
            android:layout_marginStart="70dp"
            android:id="@+id/accelerate_vert_inner"/>


    <TextView
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:text="Horizontal-acceleration"
        android:textAlignment="center"
        android:paddingTop="75dp"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/circle_outer_foreground"
        android:id="@+id/accelerate_horizontal_outer"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle_foreground"
            android:layout_below="@id/accelerate_horizontal_outer"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-140dp"
            android:layout_marginEnd="70dp"
            android:id="@+id/accelerate_horizontal_inner"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="land"
        android:background="@drawable/circle_foreground"
        android:layout_alignParentStart="true"
        android:layout_marginStart="100dp"
        android:layout_centerVertical="true"
        android:id="@+id/land"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/circle_foreground"
        android:text="ON/OFF"
        android:layout_alignParentEnd="true"
        android:layout_margin="100dp"
        android:layout_centerVertical="true"
        android:id="@+id/connect"/>

</RelativeLayout>